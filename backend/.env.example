# PodLaunch Backend Configuration
PROJECT_NAME="PodLaunch Serverless Platform"
API_V1_STR="/api/v1"
DEBUG=true

# Supabase PostgreSQL Connection (Transaction Pooler or Direct URI)
# Example: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local PostgreSQL Fallback (Used if DATABASE_URL is empty)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=podlaunch_user
POSTGRES_PASSWORD=podlaunch_secret
POSTGRES_DB=podlaunch_db

# Docker Engine & Isolation Defaults
DOCKER_HOST=npipe:////./pipe/docker_engine
DEFAULT_MEMORY_LIMIT_MB=128
DEFAULT_CPU_QUOTA=0.5
DEFAULT_TIMEOUT_SECONDS=5.0

# Pool Management Defaults
DEFAULT_STRATEGY=PREDICTIVE_PRE_WARM
KEEP_ALIVE_TTL_SECONDS=30
FIXED_PREWARM_WATERMARK=2
PREDICTIVE_BUCKET_MINUTES=5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_YnJhdmUtc2hhcmstMzUwOS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_V6eFDF3AbtadhXC3ohe7QCTOnDn5ft0H9gydjYj7np
