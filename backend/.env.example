# PodLaunch Backend Configuration
PROJECT_NAME="PodLaunch Serverless Platform"
API_V1_STR="/api/v1"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=podlaunch_user
POSTGRES_PASSWORD=podlaunch_secret
POSTGRES_DB=podlaunch_db

# Docker Engine
DOCKER_HOST=npipe:////./pipe/docker_engine
DEFAULT_MEMORY_LIMIT_MB=128
DEFAULT_CPU_QUOTA=0.5
DEFAULT_TIMEOUT_SECONDS=5.0

# Pool Management Defaults
DEFAULT_STRATEGY=PREDICTIVE_PRE_WARM
KEEP_ALIVE_TTL_SECONDS=30
FIXED_PREWARM_WATERMARK=2
PREDICTIVE_BUCKET_MINUTES=5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
